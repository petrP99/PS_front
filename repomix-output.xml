<file path="src/pages/MyCardsPage.jsx">
import React, { useState, useEffect } from 'react';
import { createCard, getMyCards, blockCard } from '../api';
import ConfirmationModal from '../components/ConfirmationModal';

export default function MyCardsPage() {
  const [cards, setCards] = useState([]);
  const [loading, setLoading] = useState(true);
  const [cardToBlock, setCardToBlock] = useState(null);
  const [showCreateForm, setShowCreateForm] = useState(false);
  const [newCardData, setNewCardData] = useState({ name: '', currency: 'RUB' });

  useEffect(() => {
    fetchCards();
  }, []);

  const fetchCards = async () => {
    try {
      setLoading(true);
      const cards = await getMyCards();
      setCards(cards);
    } catch (error) {
      console.error('Ошибка при загрузке карт:', error);
      alert(`Ошибка: ${error.message}`);
    } finally {
      setLoading(false);
    }
  };

  const handleCreateCard = async () => {
    try {
      await createCard(newCardData.name || undefined, newCardData.currency);
      fetchCards();
      setShowCreateForm(false);
      setNewCardData({ name: '', currency: 'RUB' });
      alert('Карта успешно создана!');
    } catch (error) {
      console.error('Ошибка создания карты:', error);
      alert(`Ошибка: ${error.message}`);
    }
  };

  const handleBlockCard = async () => {
    if (!cardToBlock) return;
    
    try {
      await blockCard(cardToBlock.id);
      fetchCards();
      alert('Карта успешно заблокирована!');
    } catch (error) {
      console.error('Ошибка блокировки карты:', error);
      alert(`Ошибка: ${error.message}`);
    } finally {
      setCardToBlock(null);
    }
  };

  // Группируем карты по валюте
  const cardsByCurrency = {};
  cards.forEach(card => {
    if (!cardsByCurrency[card.currency]) {
      cardsByCurrency[card.currency] = [];
    }
    cardsByCurrency[card.currency].push(card);
  });

  return (
    <div style={{ animation: 'fadeIn 0.5s ease-out' }}>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '2rem' }}>
        <h1 style={{ fontSize: '1.8rem', fontWeight: 700 }}>Мои карты</h1>
        <button 
          className="glass" 
          style={{ padding: '0.7rem 1.5rem', background: 'rgba(99,102,241,0.2)', border: '1px solid rgba(99,102,241,0.4)', borderRadius: '12px', cursor: 'pointer' }}
          onClick={() => setShowCreateForm(true)}
        >
          Создать карту
        </button>
      </div>

      {showCreateForm && (
        <div className="glass" style={{ padding: '1.5rem', marginBottom: '2rem', borderRadius: '16px' }}>
          <h2 style={{ fontSize: '1.2rem', fontWeight: 600, marginBottom: '1rem' }}>Создание новой карты</h2>
          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '1rem', marginBottom: '1.5rem' }}>
            <div>
              <label style={{ display: 'block', marginBottom: '0.5rem', fontSize: '0.9rem' }}>Название карты (необязательно)</label>
              <input
                type="text"
                className="glass"
                style={{ width: '100%', padding: '0.8rem', borderRadius: '10px', border: '1px solid rgba(255,255,255,0.1)', background: 'rgba(255,255,255,0.05)' }}
                value={newCardData.name}
                onChange={e => setNewCardData({ ...newCardData, name: e.target.value })}
                placeholder="Например, Основная карта"
              />
            </div>
            <div>
              <label style={{ display: 'block', marginBottom: '0.5rem', fontSize: '0.9rem' }}>Валюта</label>
              <select
                className="glass"
                style={{ width: '100%', padding: '0.8rem', borderRadius: '10px', border: '1px solid rgba(255,255,255,0.1)', background: 'rgba(255,255,255,0.05)' }}
                value={newCardData.currency}
                onChange={e => setNewCardData({ ...newCardData, currency: e.target.value })}
              >
                <option value="RUB">Рубль (RUB)</option>
                <option value="USD">Доллар (USD)</option>
                <option value="CNY">Юань (CNY)</option>
              </select>
            </div>
          </div>
          <div style={{ display: 'flex', gap: '1rem' }}>
            <button 
              className="glass" 
              style={{ padding: '0.7rem 1.5rem', background: 'rgba(99,102,241,0.3)', borderRadius: '10px', cursor: 'pointer' }}
              onClick={handleCreateCard}
            >
              Создать
            </button>
            <button 
              className="glass" 
              style={{ padding: '0.7rem 1.5rem', border: '1px solid rgba(255,255,255,0.1)', borderRadius: '10px', cursor: 'pointer' }}
              onClick={() => setShowCreateForm(false)}
            >
              Отмена
            </button>
          </div>
        </div>
      )}

      {loading ? (
        <div style={{ textAlign: 'center', padding: '2rem' }}>
          <p>Загрузка карт...</p>
        </div>
      ) : Object.keys(cardsByCurrency).length === 0 ? (
        <div className="glass" style={{ padding: '2rem', textAlign: 'center', borderRadius: '16px' }}>
          <p>У вас пока нет карт</p>
        </div>
      ) : (
        Object.entries(cardsByCurrency).map(([currency, currencyCards]) => (
          <div key={currency} className="glass" style={{ padding: '1.5rem', marginBottom: '2rem', borderRadius: '16px' }}>
            <h2 style={{ fontSize: '1.2rem', fontWeight: 600, marginBottom: '1rem' }}>
              {currency === 'RUB' ? 'Рубли' : currency === 'USD' ? 'Доллары' : 'Юани'} ({currency})
            </h2>
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(300px, 1fr))', gap: '1rem' }}>
              {currencyCards.map(card => (
                <div key={card.id} className="glass" style={{ padding: '1.5rem', borderRadius: '14px', position: 'relative' }}>
                  <div style={{ fontSize: '1.1rem', fontWeight: 500, marginBottom: '0.5rem' }}>
                    {card.name || `Карта ${card.id.toString().slice(-4)}`}
                  </div>
                  <div style={{ fontSize: '1.8rem', fontWeight: 700, marginBottom: '1rem' }}>
                    {card.balance.toLocaleString('ru-RU')} {currency}
                  </div>
                  <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: '0.9rem', color: 'rgba(255,255,255,0.6)' }}>
                    <span>XXXX-XXXX-XXXX-{card.id.toString().slice(-4)}</span>
                    <span>{card.expireDate}</span>
                  </div>
                  <div style={{ marginTop: '1rem', display: 'flex', gap: '0.5rem' }}>
                    <button 
                      className="glass" 
                      style={{ padding: '0.5rem 1rem', fontSize: '0.9rem', borderRadius: '8px', cursor: 'pointer', flex: 1 }}
                      onClick={() => window.location.href = `/cards/${card.id}`}
                    >
                      Подробнее
                    </button>
                    {card.status === 'ACTIVE' && card.balance === 0 && (
                      <button 
                        className="glass" 
                        style={{ padding: '0.5rem 1rem', fontSize: '0.9rem', background: 'rgba(236,72,153,0.2)', border: '1px solid rgba(236,72,153,0.4)', borderRadius: '8px', cursor: 'pointer' }}
                        onClick={() => setCardToBlock(card)}
                      >
                        Заблокировать
                      </button>
                    )}
                  </div>
                  {card.status === 'BLOCKED' && (
                    <div style={{ position: 'absolute', top: '1rem', right: '1rem', background: 'rgba(255,0,0,0.2)', color: '#f472b6', padding: '0.3rem 0.6rem', borderRadius: '4px', fontSize: '0.8rem' }}>
                      Заблокирована
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))
      )}

      <ConfirmationModal
        isOpen={!!cardToBlock}
        title="Подтверждение блокировки"
        message={`Вы уверены, что хотите заблокировать карту ${cardToBlock?.id || ''}?`}
        onConfirm={handleBlockCard}
        onCancel={() => setCardToBlock(null)}
      />
    </div>
  );
}
</file>

